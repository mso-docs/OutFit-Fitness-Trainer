{
  "name": "outfit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"APP_DEV_ORIGIN=http://127.0.0.1:5173 tsx watch apps/api/src/server.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx apps/api/src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write apps packages scripts tests docs README.md *.ts *.js *.json",
    "smoke:ollama": "tsx scripts/ollama-smoke.ts",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "dev:pages": "vite --mode pages --host 127.0.0.1",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1 --port 4173",
    "check:public": "python3 scripts/check-public.py",
    "test:pages": "playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "fastify": "^5.6.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.5",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
